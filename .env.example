# ---------------------------------------------------------------------------
# Neon Postgres
#
# Two connection strings, deliberately. Neon gives you both in the dashboard.
#
#   DATABASE_URL           pooled endpoint  (host contains "-pooler")
#                          used by the request path
#   DATABASE_URL_UNPOOLED  direct endpoint  (no "-pooler")
#                          used by migrations: DDL, CREATE ROLE, GRANT
#
# IMPORTANT: DATABASE_URL must be the itam_app role, NOT the Neon owner role.
# The append-only audit guarantee is a GRANT, and grants do not apply to the
# table owner. Connecting as the owner silently voids it.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://itam_app:REPLACE_ME@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:REPLACE_ME@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Password assigned to the itam_app role by scripts/migrate.mjs.
# Must match the password in DATABASE_URL above.
APP_DB_PASSWORD=change-me-in-production

# Pepper for OTP hashing. Rotating this invalidates all in-flight handshakes.
OTP_PEPPER=change-me-in-production

APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Upstash QStash — event broker + scheduler.
#
# With these unset, the outbox drainer delivers events by calling the worker
# in-process instead of through a real queue, and cron routes fall back to
# CRON_SECRET bearer auth instead of QStash's request signature. The pipeline
# still runs end to end either way — only the transport changes.
# ---------------------------------------------------------------------------
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# Bearer secret for /api/cron/* when QSTASH_CURRENT_SIGNING_KEY is not set.
CRON_SECRET=change-me-in-production

# HMAC-SHA256 secret the HRIS must sign /api/webhooks/hris payloads with
# (header: x-hris-signature: sha256=<hex>).
HRIS_WEBHOOK_SECRET=change-me-in-production

# ---------------------------------------------------------------------------
# Deferred to a later milestone — intentionally unset.
# ---------------------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
